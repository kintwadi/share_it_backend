# Template .env for Vicinity24 Backend (no secrets)
#
# Copy to .env and fill in values for local development.
# On Render, set these in the Environment tab instead of using a file.

# Runtime (Render handles TLS; run app HTTP behind proxy)
PORT=8080
SSL_ENABLED=false
SETTINGS_HTTP_ENABLED=false

# Database (required)
DB_TYPE=postgres
DB_URL=jdbc:postgresql://your-postgres-host:5432/Vicinity24?sslmode=require
DB_USERNAME=vicinity24_user
DB_PASSWORD=your_db_password
DB_DRIVER=

# Multi-tenant database-per-tenant routing
# Keep SETTING_USE_DEFAULT_DATABASE=true to preserve existing single-tenant behavior
# when X-Tenant-ID is not provided.
SETTING_USE_DEFAULT_DATABASE=true
TENANT_HEADER_NAME=X-Tenant-ID
TENANT_DEFAULT_ID=default
TENANT_DEFAULT_DB_URL=jdbc:postgresql://your-postgres-host:5432/Vicinity24?sslmode=require
TENANT_DEFAULT_DB_USERNAME=vicinity24_user
TENANT_DEFAULT_DB_PASSWORD=your_db_password
TENANT_DEFAULT_DB_DRIVER=org.postgresql.Driver
# Optional additional static tenants:
# TENANT_A_DB_URL=jdbc:postgresql://your-postgres-host:5432/Vicinity24TenantA?sslmode=require
# TENANT_A_DB_USERNAME=tenant_a_user
# TENANT_A_DB_PASSWORD=tenant_a_password
# TENANT_A_DB_DRIVER=org.postgresql.Driver
# TENANT_B_DB_URL=jdbc:postgresql://your-postgres-host:5432/Vicinity24TenantB?sslmode=require
# TENANT_B_DB_USERNAME=tenant_b_user
# TENANT_B_DB_PASSWORD=tenant_b_password
# TENANT_B_DB_DRIVER=org.postgresql.Driver

# Render note:
# If your Postgres host resolves to IPv6-only and your runtime has no IPv6 egress, use the Supabase pooler host instead.
# You can also force Java to prefer IPv4 with:
# JAVA_TOOL_OPTIONS=-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false

# SQLite + Litestream + Cloudflare R2 (Render)
SQLITE_R2_STREAM_FOR_RENDER=false
SQLITE_DB_PATH=/data/vicinity24.sqlite
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_ENDPOINT=https://a9350353a46ee6697062d84ad27c0c2e.r2.cloudflarestorage.com
LITESTREAM_BUCKET=sqlitedb
LITESTREAM_PATH=production

# JWT (required - recommended)
JWT_SECRET=replace_with_long_random_secret

# Admin
ADMIN_SIGNUP_SECRET=

# JWT Keystore (optional - only if you prefer keystore-based signing)
JWT_KEYSTORE_LOCATION=file:/etc/secrets/keystore.p12
JWT_KEYSTORE_PASSWORD=your_keystore_password
JWT_KEYSTORE_TYPE=PKCS12
KEYSTORE_ACCESS_TOKEN_ALIAS=accesstoken
KEYSTORE_ACCESS_TOKEN_PW=your_access_token_key_password
KEYSTORE_REFRESH_TOKEN_ALIAS=refreshtoken
KEYSTORE_REFRESH_TOKEN_PW=your_refresh_token_key_password

# Encryption (required)
ENCRYPTION_KEY=replace_with_16+_chars_key

# App URLs
FRONTEND_BASE_URL=https://localhost:4200

# Geolocation (FreeIPAPI)
GEOLOCATION_BASE_URL=https://free.freeipapi.com/api/json/
GEOLOCATION_ENABLED=false

# LocationIQ (required for address parsing)
LOCATION_IQ_API_KEY=
LOCATION_IQ_BASE_URL=https://us1.locationiq.com
LOCATION_IQ_COUNTRYCODES=pt,de,fr,be

# SMTP (optional toggles)
# For STARTTLS on 587:
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false
# For implicit TLS/SSL on 465:
#MAIL_SMTP_STARTTLS_ENABLE=false
#MAIL_SMTP_SSL_ENABLE=true
MAIL_SMTP_SSL_TRUST=*
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000

# Stripe (optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Subscription price IDs are now provisioned and stored at runtime via:
# POST /api/admin/stripe/provision-subscriptions

# Storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
