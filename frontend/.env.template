# Web runtime values are generated into frontend/public/env.js from environment variables.
# Useful variables:
# API_URL=/api/v1
# UI_LAYOUT=MODERN
# TENANT_HEADER_NAME=X-Tenant-ID
# TENANT_ID=
#
# Android uses frontend/.env.android instead.
# Copy frontend/.env.android.template to frontend/.env.android and edit:
#
# ANDROID_API_URL=http://192.168.178.114:8081/api/v1
# ANDROID_TENANT_HEADER_NAME=X-Tenant-ID
# ANDROID_TENANT_ID=
