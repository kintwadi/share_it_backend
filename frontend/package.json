{
  "name": "share-it-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test:bike:headed": "node scripts/playwright-headed-bike-check.mjs",
    "test:bike:headed:install": "npx playwright install chromium && npm run test:bike:headed",
    "build:android": "node scripts/build-android.cjs",
    "build:android:remote": "node scripts/build-android.cjs --remote",
    "build:android:open": "node scripts/build-android.cjs --open",
    "build:android:run": "node scripts/build-android.cjs --run",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.6",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@stomp/stompjs": "^7.2.1",
    "@stripe/stripe-js": "^9.0.0",
    "@types/qrcode": "^1.5.6",
    "lucide-angular": "^1.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
