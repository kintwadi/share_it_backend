# Environment Variables Template for NearShare Backend
# Copy this file to .env and fill in your actual values

# ========== DATABASE CONFIGURATION ==========
# PostgreSQL database connection (required)
DB_URL=jdbc:postgresql://your-postgres-host:5432/your-database
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# ========== TLS / KEYSTORE ==========
SSL_PASSWORD=your_keystore_password
KEYSTORE_ACCESS_TOKEN_ALIAS=accesstoken
KEYSTORE_ACCESS_TOKEN_PW=your_access_token_key_password
KEYSTORE_REFRESH_TOKEN_ALIAS=refreshtoken
KEYSTORE_REFRESH_TOKEN_PW=your_refresh_token_key_password

# ========== ENCRYPTION ==========
ENCRYPTION_KEY=1234567890123456

# ========== AWS S3 CONFIGURATION ==========
# AWS credentials for S3 storage (optional - only if using AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ========== CLOUDFLARE R2 CONFIGURATION ==========
# Cloudflare R2 storage (optional - only if using R2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-url.com

# ========== STRIPE PAYMENT CONFIGURATION ==========
# Stripe API keys (optional - only if using Stripe payments)
STRIPE_PUBLIC_KEY=test_public_key
STRIPE_SECRET_KEY=test_secret_key
STRIPE_WEBHOOK_SECRET=test_webhook_secret

# ========== APPLICATION SETTINGS ==========
# Server port (default: 8081)
SERVER_PORT=8081

# ========== NOTES ==========
# 1. Database credentials should match your PostgreSQL installation
# 3. Only configure the storage services you plan to use (AWS S3 or Cloudflare R2)
# 4. Stripe keys are only needed if you're implementing payment functionality
