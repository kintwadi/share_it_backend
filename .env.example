# Database Configuration
DB_TYPE=postgres
DB_URL=jdbc:postgresql://your-postgres-host:5432/nearshare
DB_USERNAME=nearshare_user
DB_PASSWORD=your_secure_password_here
DB_DRIVER=

# SQLite + Litestream + Cloudflare R2 (Render)
SQLITE_R2_STREAM_FOR_RENDER=false
SQLITE_DB_PATH=/data/nearshare.sqlite
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
LITESTREAM_BUCKET=sqlitedb
LITESTREAM_PATH=production

# JWT Configuration (recommended)
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here

# JWT Keystore Configuration (optional)
JWT_KEYSTORE_LOCATION=file:/etc/secrets/keystore.p12
JWT_KEYSTORE_PASSWORD=your_keystore_password
JWT_KEYSTORE_TYPE=PKCS12
KEYSTORE_ACCESS_TOKEN_ALIAS=accesstoken
KEYSTORE_ACCESS_TOKEN_PW=your_access_token_key_password
KEYSTORE_REFRESH_TOKEN_ALIAS=refreshtoken
KEYSTORE_REFRESH_TOKEN_PW=your_refresh_token_key_password

# Encryption (required)
ENCRYPTION_KEY=replace_with_16+_chars_key

# AWS S3 Configuration (if using AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Cloudflare R2 Configuration (if using R2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev

# Stripe Payment Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SUBSCRIPTION_PLUS_STRIPE_PRICE_ID=price_plus
SUBSCRIPTION_PRO_STRIPE_PRICE_ID=price_pro

# Frontend
FRONTEND_BASE_URL=https://your-frontend-domain

# Render / Docker runtime
PORT=8080
SSL_ENABLED=false
SETTINGS_HTTP_ENABLED=false

# Application Settings
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=production
